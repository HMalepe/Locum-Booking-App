# Email notifications via Resend (https://resend.com) — same stack as ExpiryDesk.
# Copy this file to .env.local and fill in your values.

# Your Resend API key. Without it, emails are logged to the server console
# instead of sent (fine for local development).
RESEND_API_KEY=

# Verified sender. Use your verified domain in Resend.
# Falls back to Resend's onboarding sender if unset.
EMAIL_FROM="Locum Planner <notifications@yourdomain.co.za>"

# Public URL of the app, used for links inside emails.
APP_URL=http://localhost:3000
